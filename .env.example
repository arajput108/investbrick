# InvestBrick environment variables.
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is git-ignored. NEVER commit real keys, and never paste them into chat, issues or screenshots.
# On Render, set these in: your service > Environment (do not put secrets in render.yaml).

# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=3000

# Public address of the site, no trailing slash. Used to build password-reset links (never taken from the request's Host header).
# Production must be your real https:// address, e.g. https://investbrick.onrender.com
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- database
# Local development with zero setup (embedded Postgres, dev/test only; refused in production):
DB_DRIVER=pglite
# PGLITE_DIR=.data/pglite

# Real PostgreSQL / Neon (required in production). Use Neon's DIRECT connection string (Connect > Connection pooling OFF, host has no "-pooler");
# the pooled string may be rejected ("unsupported startup parameter"). It must include ?sslmode=require:
# DB_DRIVER=pg
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/YOUR_DB?sslmode=require

# ---------------------------------------------------------------- password-reset email (Brevo)
# development: 'console' prints the reset link in the server terminal instead of sending email (not allowed in production).
# production : 'brevo-api' sends over HTTPS (port 443), which works on Render's free plan. 'smtp' is the alternative (see below).
#              Leave email unset in production and "Forgot password" honestly answers 503 "not available"; it never pretends to send.
EMAIL_PROVIDER=console

# Brevo > SMTP & API > API keys (the API key, NOT the SMTP key). Free plan, no card needed.
# BREVO_API_KEY=REPLACE_WITH_YOUR_BREVO_API_KEY

# Must be a sender you verified in Brevo (Senders & IP > Senders), written exactly like this:
# EMAIL_FROM=InvestBrick <your-verified-sender@example.com>

# Optional SMTP route (not usable on Render's free plan: SMTP ports are blocked there):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=REPLACE_WITH_SMTP_LOGIN
# SMTP_PASS=REPLACE_WITH_SMTP_KEY

# ---------------------------------------------------------------- reset-flow limits (all optional; defaults shown)
# Reset emails allowed per account per hour (1-20). A 60-second cooldown between requests always applies as well.
# RESET_MAX_PER_HOUR=3

# ---------------------------------------------------------------- hosting (production)
# Set to 1 behind Render/nginx so rate limits and secure cookies see the real client IP. Required in production.
# TRUST_PROXY=1

# ---------------------------------------------------------------- other optional settings
# COINGECKO_API_KEY=REPLACE_WITH_FREE_COINGECKO_DEMO_KEY
# CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING        # enables the scheduled wake-up endpoint; unset = endpoint does not exist
# LOG_LEVEL=info
# SESSION_DAYS=30
# SESSION_IDLE_DAYS=7
# MATCHER_ENABLED=true
# MIGRATE_ON_START=true
